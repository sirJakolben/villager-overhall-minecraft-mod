    { "when": { "facing": "south" }, "apply": { "model": "villageroverhaul:block/book_pile_1", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "villageroverhaul:block/book_pile_1", "y": 270 } },
    { "when": { "facing": "north", "books": "2|3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_2" } },
    { "when": { "facing": "east", "books": "2|3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_2", "y": 90 } },
    { "when": { "facing": "south", "books": "2|3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_2", "y": 180 } },
    { "when": { "facing": "west", "books": "2|3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_2", "y": 270 } },
    { "when": { "facing": "north", "books": "3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_3" } },
    { "when": { "facing": "east", "books": "3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_3", "y": 90 } },
    { "when": { "facing": "south", "books": "3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_3", "y": 180 } },
    { "when": { "facing": "west", "books": "3|4" }, "apply": { "model": "villageroverhaul:block/book_pile_3", "y": 270 } },
    { "when": { "facing": "north", "books": "4" }, "apply": { "model": "villageroverhaul:block/book_pile_4" } },
    { "when": { "facing": "east", "books": "4" }, "apply": { "model": "villageroverhaul:block/book_pile_4", "y": 90 } },
    { "when": { "facing": "south", "books": "4" }, "apply": { "model": "villageroverhaul:block/book_pile_4", "y": 180 } },
    { "when": { "facing": "west", "books": "4" }, "apply": { "model": "villageroverhaul:block/book_pile_4", "y": 270 } }
  ]
